# ---------- CineMemory environment ----------

# Gemini / Google AI. Get a key at https://aistudio.google.com/apikey
# When unset, CineMemory refuses to run LLM agents unless LLM_PROVIDER=fixture.
# !! Put the real key ONLY in a git-ignored `.env` file. Never in this file: GitHub secret scanning
# !! reports committed Google keys and Google revokes them within minutes ("API key was reported as leaked").
GEMINI_API_KEY=

# Alternatively use Vertex AI (Application Default Credentials) instead of an API key.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# LLM provider: "gemini" (default when GEMINI_API_KEY is set) or "fixture".
# "fixture" is a DEVELOPMENT mode that replays recorded/authored responses for the
# bundled demo project only. It never impersonates Gemini: every artifact is stamped
# with provider="fixture" and the UI shows a banner.
LLM_PROVIDER=
# gemini-2.5-flash is retired for new keys; the API recommends gemini-3.6-flash.
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash

# Media generation provider: "gemini" (Imagen/Veo/TTS through @google/genai) or "placeholder".
# "placeholder" writes clearly-labelled SVG storyboard cards and no video/audio.
MEDIA_PROVIDER=
# Image generation requires a billing-enabled project: the free tier reports quota 0 for image models.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Veo clips: families opt in per story ("Moving pictures"); set "true" to generate clips for every project by default (billable, slow).
ENABLE_VIDEO_GENERATION=false
# ffmpeg is used to render the final MP4 (clips or held pictures + voice). Auto-detected on PATH or via `pip install imageio-ffmpeg`; override here.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Persistence (SQLite file + media directory). Relative to repo root.
CINEMEMORY_DATA_DIR=./data

# ---------- ClickHouse (partner track): persistent production memory ----------
# Production: ClickHouse Cloud (https://clickhouse.cloud) — HTTPS endpoint on port 8443.
#   CLICKHOUSE_URL=https://<host>.<region>.clickhouse.cloud:8443
# Local development without Docker: `pip install chdb` then `pnpm clickhouse:local` (real ClickHouse engine, HTTP shim).
#   CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_URL=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cinememory
# Partner adapter: "clickhouse" (default when CLICKHOUSE_URL is set) or "local" (development only).
PARTNER_ADAPTER=

# Family app sign-in. Local email/password accounts always work. For "Continue with Google", create an OAuth 2.0
# Web client in Google Cloud Console (APIs & Services → Credentials), add http://localhost:3000 (and your hosted URL)
# to "Authorised JavaScript origins", and paste the client id here. The web app reads it from the API.
GOOGLE_OAUTH_CLIENT_ID=

# API server
API_PORT=8787
# Web app -> API base URL
NEXT_PUBLIC_API_URL=http://localhost:8787

# Repair loop
REPAIR_MAX_ATTEMPTS=2
