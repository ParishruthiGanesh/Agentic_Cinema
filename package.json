{
  "name": "cinememory",
  "version": "0.1.0",
  "private": true,
  "description": "CineMemory — the memory & verification layer for agentic filmmaking",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @cinememory/api dev",
    "dev:web": "pnpm --filter @cinememory/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "demo:seed": "pnpm --filter @cinememory/api seed:demo",
    "eval": "pnpm --filter @cinememory/api eval"
  },
  "engines": {
    "node": ">=22.13"
  }
}
