{
  "name": "@cinememory/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node --no-warnings dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:demo": "tsx src/cli.ts seed-demo",
    "eval": "tsx src/cli.ts evaluate",
    "gemini:smoke": "tsx src/gemini-smoke.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@cinememory/core": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "zod": "^4.0.0",
    "@cinememory/agent": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
