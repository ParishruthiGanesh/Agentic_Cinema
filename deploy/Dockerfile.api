# CineMemory API (+ ADK Producer agent) — Cloud Run friendly image.
# Build from the repo root:  docker build -f deploy/Dockerfile.api -t cinememory-api .
# Runtime env (Cloud Run "Variables & Secrets"): GEMINI_API_KEY, CLICKHOUSE_URL, CLICKHOUSE_USER,
# CLICKHOUSE_PASSWORD, CLICKHOUSE_DATABASE, MEDIA_PROVIDER=gemini, ENABLE_VIDEO_GENERATION.
FROM node:22-slim AS build
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/core/package.json packages/core/
COPY apps/agent/package.json apps/agent/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --filter @cinememory/core --filter @cinememory/agent --filter @cinememory/api
COPY packages/core packages/core
COPY apps/agent apps/agent
COPY apps/api apps/api
RUN pnpm --filter @cinememory/core build && pnpm --filter @cinememory/agent build && pnpm --filter @cinememory/api build

FROM node:22-slim
# python3 + mcp-clickhouse give the Producer agent the official ClickHouse MCP toolset.
# ffmpeg renders the final MP4 (clips or held pictures + voice).
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg && rm -rf /var/lib/apt/lists/* \
  && pip3 install --break-system-packages --no-cache-dir mcp-clickhouse
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app
COPY --from=build /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/core/package.json packages/core/package.json
COPY --from=build /app/packages/core/dist packages/core/dist
COPY --from=build /app/packages/core/node_modules packages/core/node_modules
COPY --from=build /app/apps/agent/package.json apps/agent/package.json
COPY --from=build /app/apps/agent/dist apps/agent/dist
COPY --from=build /app/apps/agent/node_modules apps/agent/node_modules
COPY --from=build /app/apps/api/package.json apps/api/package.json
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/apps/api/node_modules apps/api/node_modules
ENV NODE_ENV=production
ENV CINEMEMORY_DATA_DIR=/data
ENV API_PORT=8080
EXPOSE 8080
VOLUME ["/data"]
WORKDIR /app/apps/api
CMD ["node", "--no-warnings", "dist/server.js"]
